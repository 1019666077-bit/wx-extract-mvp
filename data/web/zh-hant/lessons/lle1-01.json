      "speaker": "Pete",
      "en": "I am Pete.",
      "zh": "我是皮特。"
    },
    {
      "speaker": "Anna",
      "en": "Nice to meet you.",
      "zh": "很高興認識你。"
    },
    {
      "speaker": "Anna",
      "en": "Let's try that again. I'm Anna. Nice to meet you.",
      "zh": "我們再試一次。我是安娜。很高興認識你。"
    },
    {
      "speaker": "Pete",
      "en": "I'm Pete. \"Anna\" Is that A-N-A?",
      "zh": "我是皮特。“安娜”是拼成 A-N-A 嗎？"
    },
    {
      "speaker": "Anna",
      "en": "No. A-N-N-A",
      "zh": "不是。是 A-N-N-A。"
    },
    {
      "speaker": "Pete",
      "en": "Well, Anna with two \"n's\" ... Welcome to ... 1400 Irving Street!",
      "zh": "好的，有兩個 n 的安娜……歡迎來到……歐文街 1400 號！"
    },
    {
      "speaker": "Anna",
      "en": "My new apartment! Yes!",
      "zh": "我的新公寓！太好了！"
    }
