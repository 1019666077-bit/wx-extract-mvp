      "speaker": "Pete",
      "en": "Hi! Are you Anna?",
      "zh": "嗨！你是安娜嗎？"
    },
    {
      "speaker": "Anna",
      "en": "Yes! Hi there! Are you Pete?",
      "zh": "是的！你好！你是皮特嗎？"
    },
