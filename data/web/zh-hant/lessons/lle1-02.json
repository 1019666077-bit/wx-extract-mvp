  "dialogue": [
    {
      "speaker": "Jonathan",
      "en": "Hey, Pete! Who’s your friend?",
      "zh": "嘿，皮特！你的朋友是誰？"
    },
    {
      "speaker": "Pete",
      "en": "She is Anna. She is new to D.C.",
      "zh": "她是安娜。她剛到華盛頓特區。"
    },
    {
      "speaker": "Jonathan",
      "en": "Where are you from?",
      "zh": "你來自哪裡？"
    },
    {
      "speaker": "Anna",
      "en": "I am from a small town.",
      "zh": "我來自一個小鎮。"
    },
    {
      "speaker": "Jonathan",
      "en": "Well, welcome to D.C.",
      "zh": "好的，歡迎來到華盛頓特區。"
    },
    {
      "speaker": "Anna",
      "en": "Thank you.",
      "zh": "謝謝。"
    },
    {
      "speaker": "Jonathan",
      "en": "I am Jonathan. I am in apartment B4.",
      "zh": "我是喬納森。我住在 B4 公寓。"
    },
    {
      "speaker": "Anna",
      "en": "I am in apartment C2. Marsha is my roommate.",
      "zh": "我住在 C2 公寓。瑪莎是我的室友。"
    },
    {
      "speaker": "Jonathan",
      "en": "I know Marsha. She is nice.",
      "zh": "我認識瑪莎。她人很好。"
    },
    {
      "speaker": "Pete",
      "en": "And I am in Apartment D7. I have to go now.",
      "zh": "我住在 D7 公寓。我現在得走了。"
    },
    {
      "speaker": "Anna",
      "en": "Oh!",
      "zh": "哦！"
    },
    {
      "speaker": "Pete",
      "en": "Remember to call Marsha at work. Tell her you’re here.",
      "zh": "記得給上班的瑪莎打電話。告訴她你到了。"
    },
    {
      "speaker": "Anna",
      "en": "Right, thanks, Pete. Nice to meet you!",
      "zh": "好的，謝謝，皮特。很高興認識你！"
    },
    {
      "speaker": "Jonathan",
      "en": "You too, Bye.",
      "zh": "我也是，再見。"
    },
    {
      "speaker": "Anna",
      "en": "Apartment C2, here I come!",
      "zh": "C2 公寓，我來了！"
    }
  ],
