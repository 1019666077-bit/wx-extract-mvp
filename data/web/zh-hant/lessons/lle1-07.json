  "dialogue": [
    {
      "speaker": "Caty",
      "en": "Come in.",
      "zh": "進來。"
    },
    {
      "speaker": "Caty",
      "en": "Well, Anna, welcome.",
      "zh": "安娜，歡迎。"
    },
    {
      "speaker": "Anna",
      "en": "Thank you.",
      "zh": "謝謝。"
    },
    {
      "speaker": "Caty",
      "en": "I am your boss, Caty Weaver. But, please call me Caty.",
      "zh": "我是你的老闆，凱蒂·韋弗。不過，請叫我凱蒂。"
    },
    {
      "speaker": "Anna",
      "en": "Thank you, Ms. Weaver.",
      "zh": "謝謝您，韋弗女士。"
    },
    {
      "speaker": "Caty",
      "en": "Just Caty.",
      "zh": "叫凱蒂就行。"
    },
    {
      "speaker": "Anna",
      "en": "Sure thing, Ms. Weaver.",
      "zh": "好的，韋弗女士。"
    },
    {
      "speaker": "Caty",
      "en": "Okay then. Are you excited?",
      "zh": "那好。你興奮嗎？"
    },
    {
      "speaker": "Anna",
      "en": "Yes, I am excited!",
      "zh": "是的，我很興奮！"
    },
    {
      "speaker": "Caty",
      "en": "So sorry, but I am busy. Please meet your co-workers. But remember, they are busy working.",
      "zh": "抱歉，我很忙。去見見你的同事吧。不過記住，他們正在忙著工作。"
    },
    {
      "speaker": "Anna",
      "en": "Hi there! I’m Anna.",
      "zh": "你好！我是安娜。"
    },
    {
      "speaker": "Anne",
      "en": "Hi, Anna. I’m Anne.",
      "zh": "嗨，安娜。我是安妮。"
    },
    {
      "speaker": "Anna",
      "en": "Nice to meet you. What are you doing?",
      "zh": "很高興認識你。你在做什麼？"
    },
    {
      "speaker": "Anne",
      "en": "Um, I’m writing.",
      "zh": "嗯，我在寫東西。"
    },
    {
      "speaker": "Anna",
      "en": "You are writing! You are writing a lot!",
      "zh": "你在寫東西！你寫得真多！"
    },
    {
      "speaker": "Anne",
      "en": "No! No! That's okay.",
      "zh": "不！不！沒關係。"
    },
    {
      "speaker": "Anna",
      "en": "I am sorry!",
      "zh": "對不起！"
    },
    {
      "speaker": "Jonathan",
      "en": "and people all around the world are waiting to hear news about the next president…",
      "zh": "全世界的人都在等待下一位總統的訊息……"
    },
    {
      "speaker": "Anna",
      "en": "Jonathan, hi! Remember me? I live in your building.",
      "zh": "喬納森，嗨！還記得我嗎？我住在你那棟樓裡。"
    },
    {
      "speaker": "Anna",
      "en": "What are you doing?",
      "zh": "你在做什麼？"
    },
    {
      "speaker": "Jonathan",
      "en": "I am doing my show!",
      "zh": "我在做我的節目！"
    },
    {
      "speaker": "Anna",
      "en": "Oh, sorry. Are you recording?",
      "zh": "哦，抱歉。你在錄音嗎？"
    },
    {
      "speaker": "Jonathan",
      "en": "Yes! And, now I have to record again!",
      "zh": "是的！現在我又得重新錄一遍！"
    },
    {
      "speaker": "Anna",
      "en": "Sorry. Have a good show.",
      "zh": "抱歉。節目順利。"
    },
    {
      "speaker": "Amelia",
      "en": "The word of the day is social.",
      "zh": "今日單詞是 social。"
    },
    {
      "speaker": "Anna",
      "en": "Nice to meet you! What are you doing?",
      "zh": "很高興認識你！你在做什麼？"
    },
    {
      "speaker": "Amelia",
      "en": "I’m reading.",
      "zh": "我在讀稿。"
    },
    {
      "speaker": "Anna",
      "en": "Are you reading the news?",
      "zh": "你在讀新聞嗎？"
    },
    {
      "speaker": "Amelia",
      "en": "No, I’m reading for my show.",
      "zh": "不是，我在為我的節目讀稿。"
    },
    {
      "speaker": "Caty",
      "en": "Anna! Hi! What’re you doing?",
      "zh": "安娜！嗨！你在做什麼？"
    },
    {
      "speaker": "Anna",
      "en": "I am bothering people, Ms. Weaver.",
      "zh": "我在打擾別人，韋弗女士。"
    },
    {
      "speaker": "Caty",
      "en": "Let’s go to my office and talk.",
      "zh": "我們去我辦公室談談。"
    },
    {
      "speaker": "Anna",
      "en": "I like to talk with you, Ms. Weaver.",
      "zh": "我喜歡和您聊天，韋弗女士。"
    }
  ],
