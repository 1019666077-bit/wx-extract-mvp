.pager {
  display: flex;
  gap: 16rpx;
}

.pager-btn {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.video-placeholder {
  background: #1d2a32;
  color: #f4f1ea;
}

.video-placeholder .eyebrow {
  color: #8fd3b5;
}

.video-placeholder .heading,
.video-placeholder .sub {
  color: #f4f1ea;
}

.paywall {
  border: 2rpx solid #9b3d12;
}

.line {
  padding: 16rpx 0;
  border-top: 1rpx solid #eee8dc;
}

.speaker {
  font-size: 22rpx;
  color: #1d4e89;
  font-weight: 650;
}

.en {
  font-size: 30rpx;
}

.zh {
  color: #5b6b74;
  font-size: 26rpx;
}

.question {
  margin: 20rpx 0;
}

.prompt {
  font-weight: 650;
  margin-bottom: 12rpx;
}

.choice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #eee8dc;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.choice.is-on {
  border-color: #0b6e4f;
  background: #f3faf6;
}

.result {
  margin-top: 8rpx;
  min-height: 40rpx;
  color: #0b6e4f;
}
