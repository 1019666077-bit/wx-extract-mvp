.pager {
  display: flex;
  gap: 16rpx;
}

.pager-btn {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.video-card {
  background: #1d2a32;
  color: #f4f1ea;
}

.video-card .eyebrow {
  color: #8fd3b5;
}

.video-wrap {
  position: relative;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #111;
  height: 0;
  padding-bottom: 56.25%;
}

.video-wrap video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.video-fallback {
  margin-top: 16rpx;
}

.video-card .sub,
.video-source {
  color: #d9d3c7;
}

.video-source {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  word-break: break-all;
}

.paywall {
  border: 2rpx solid #9b3d12;
}

.line {
  padding: 16rpx 0;
  border-top: 1rpx solid #eee8dc;
}

.speaker {
  font-size: 22rpx;
  color: #1d4e89;
  font-weight: 650;
}

.en {
  font-size: 30rpx;
}

.zh {
  color: #5b6b74;
  font-size: 26rpx;
}

.question {
  margin: 20rpx 0;
}

.prompt {
  font-weight: 650;
  margin-bottom: 12rpx;
}

.choice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #eee8dc;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.choice.is-on {
  border-color: #0b6e4f;
  background: #f3faf6;
}

.result {
  margin-top: 8rpx;
  min-height: 40rpx;
  color: #0b6e4f;
}
