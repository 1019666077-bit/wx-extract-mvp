.plans {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
}

.plan {
  flex: 1;
  border: 1rpx solid #d9d3c7;
  border-radius: 16rpx;
  padding: 24rpx;
}

.plan.is-featured {
  border-color: #0b6e4f;
  background: #f3faf6;
}

.plan-name {
  color: #5b6b74;
}

.plan-price {
  font-size: 48rpx;
  font-weight: 700;
  margin: 8rpx 0;
}

.perk,
.step {
  margin-top: 8rpx;
}

.unlock-status {
  margin: 12rpx 0 16rpx;
  color: #0b6e4f;
}

.code-input {
  border: 1rpx solid #d9d3c7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  background: #f7f4ee;
}

.result {
  margin-top: 16rpx;
  color: #1d4e89;
  min-height: 40rpx;
}
